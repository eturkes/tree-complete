# Safe, dependency-free walkthrough. No repository is modified.
TREE_COMPLETE_AGENT_MODE=preview

# Required when agent mode = codex. Must be a trusted absolute Git repository
# path whose HEAD contains a valid .tree-complete/project.json manifest.
TREE_COMPLETE_TARGET_REPO=

TREE_COMPLETE_DATA_DIR=.tree-complete
# Loopback only: 127.0.0.1, ::1, or localhost.
TREE_COMPLETE_HOST=127.0.0.1
TREE_COMPLETE_PORT=4318
