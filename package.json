{
  "name": "tree-complete",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "pnpm build:server && vite build && pnpm build:plugin",
    "build:server": "node scripts/clean-server-output.mjs && tsc -p tsconfig.server.json && node scripts/smoke-server-export.mjs",
    "build:plugin": "vite build --mode plugin && node scripts/write-plugin-manifest.mjs",
    "start": "node dist/server/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@xyflow/react": "^12.11.2",
    "fastify": "^5.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
